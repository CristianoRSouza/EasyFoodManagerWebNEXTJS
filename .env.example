# Qual backend este painel usa: "cloud" (EasyFoodAPI) ou "lan" (easyfoodmanagerAPI da loja).
BACKEND=lan

# Endereço do backend, sem barra final.
#   lan:   http://127.0.0.1:4080
#   cloud: http://localhost:3010
EASYFOOD_API_URL=http://127.0.0.1:4080

# Opcional: EasyBilling (Planos e Créditos IA). Padrão: https://billing.easysoftcloud.com.br
# Lido só no servidor.
# ADMIN_PLATFORM_URL=

# Opcional: atributo Secure do cookie de sessão ("true" ou "false").
#   false: painel servido em HTTP puro na rede da loja (senão o navegador descarta o cookie e o login não fica).
#   true:  painel atrás de HTTPS.
# Padrão quando ausente: true em produção (NODE_ENV=production), false em desenvolvimento.
# SESSION_COOKIE_SECURE=

# Opcional: relatório automático de erros (ErrorBoundary + erros não tratados do navegador).
# O navegador envia a POST /api/error-report; o servidor encaminha ao EasyGuardian com o
# cabeçalho x-report-secret — o MESMO segredo da edge function error-report-proxy do legado.
# Lido só no servidor; nunca vai ao navegador. Ausente = envio DESLIGADO (relatórios descartados).
# ERROR_REPORT_SECRET=
# Opcional: outro destino no lugar do EasyGuardian padrão. Precisa ser https:// — outro esquema
# desliga o envio (o segredo iria em claro).
# ERROR_REPORT_URL=

# Só a tela de redefinição de senha fala com o Supabase (o link do e-mail é dele). Lidos no
# SERVIDOR, em execução: a mesma build serve produção e homologação, cada uma com o seu projeto.
# Só a chave PUBLICÁVEL (sb_publishable_...) — nunca a service role.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Opcional: "homolog" mostra a faixa HOMOLOGAÇÃO e o prefixo [HOMOLOGAÇÃO] no título da aba
# (igual ao legado 1.3.12). Ausente ou qualquer outro valor = produção.
# EASYFOOD_AMBIENTE=
